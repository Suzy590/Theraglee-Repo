<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Pip</AssemblyName>
    <RootNamespace>Pip</RootNamespace>
    <!-- icon added below --><ApplicationIcon Condition="Exists('Pip.ico')">Pip.ico</ApplicationIcon>
    <Version>1.2.0</Version>
    <FileVersion>1.2.0.0</FileVersion>
    <Product>Pip</Product>
    <Company>Theraglee.com</Company>
    <!-- Filled-in file details look like a finished program to SmartScreen and
         browser download checks; a blank version block is one of their heuristics. -->
    <AssemblyTitle>Pip</AssemblyTitle>
    <Description>Pip, the Theraglee desktop pet. A small companion for the corner of your screen.</Description>
    <Copyright>Theraglee.com</Copyright>
    <NeutralLanguage>en-US</NeutralLanguage>
    <!-- Lets the Windows-targeting build run on a non-Windows machine. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="2.88.8" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="2.88.8" />
  </ItemGroup>
</Project>
